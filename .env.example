# Required: Postgres (Neon, Supabase, RDS, local — anything)
DATABASE_URL=postgres://user:pass@host:5432/mailbox

# Required: dashboard password
ADMIN_PASSWORD=

# Everything below is optional here — you can paste these on the dashboard Setup screen instead.

# Domain(s) your inboxes live on. Comma-separated. The domain's MX must point at your mail service.
# MAIL_DOMAINS=agents.example.com

# Sending + receiving through Resend (https://resend.com). Leave unset and use MAIL_PROVIDER=none to try it locally.
# RESEND_API_KEY=re_...
# MAIL_PROVIDER=none

# Optional: lets any mail server POST raw email to /api/inbound/raw
# INBOUND_SECRET=

# Optional: allow plain-http webhook URLs (testing only)
# ALLOW_HTTP_WEBHOOKS=1
